# Database (Neon Postgres)
DATABASE_URL=

# Secret required by cron endpoints (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Optional Upstash Redis cache (deferred to Phase 8 unless adopted in Phase 4)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Robinhood Chain (testnet for development, mainnet for production)
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=
NEXT_PUBLIC_ROBINHOOD_RPC_URL=

# Contract addresses (filled after deployment)
# NEXT_PUBLIC_TOKEN_CONTRACT_ADDRESS is listed in PROJECT.md; reserved and unused by the current implementation.
NEXT_PUBLIC_TOKEN_CONTRACT_ADDRESS=
NEXT_PUBLIC_DAILY_COURSE_REGISTRY_ADDRESS=
NEXT_PUBLIC_VERIFIED_RUN_REGISTRY_ADDRESS=
NEXT_PUBLIC_SEASON_PRIZE_VAULT_ADDRESS=

# Relayer/deployer account key. Server-only, never NEXT_PUBLIC, never committed.
RELAYER_PRIVATE_KEY=
